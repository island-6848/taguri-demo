{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taguri-demo",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "taguri-demo", "database_id": "REPLACE_WITH_CREATED_D1_ID", "migrations_dir": "migrations" }],
  "vars": { "ALLOW_REGISTRATION": "true" },
  "workers_dev": true
}
