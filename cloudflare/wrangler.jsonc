{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taguri-demo",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/login", "/api/*", "/migration-api/*", "/auth/*", "/recover", "/link", "/img/*", "/export.json", "/data.zip"] },
  "d1_databases": [{ "binding": "DB", "database_name": "taguri-demo", "database_id": "c0b5cd2c-28be-49d0-86cc-70edfa243bf0", "migrations_dir": "migrations" }],
  "vars": { "ALLOW_REGISTRATION": "true", "ORIGINAL_UI_BRIDGE": "true", "FIREBASE_PROJECT_ID": "taguri-97959", "FIREBASE_API_KEY": "AIzaSyDRsGE41bbB3MUEncNk9EkTDtTNtvKKA0M" },
  "workers_dev": true
}
