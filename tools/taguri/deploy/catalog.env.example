# /etc/taguri/catalog.env の見本（chmod 600・リポジトリには入れない）
GEMINI_API_KEY=
OWNER_USER_ID=
AWS_DEFAULT_REGION=ap-northeast-1
STAGE_CATALOG_BUCKET=nakaya-mao-private-play-recommendation2026
STAGE_CATALOG_KEY=stage-catalog/data.tar.gz
# 他の利用者のお気に入りの登録名・探してほしい題名も探す（サービス版の /api/catalog/*）。
# **サービス版のサーバーに向ける。** デモ版にはこの口が無い（docs/editions.md）。
# 合言葉はサービス版（Render）の TAGURI_NAMES_TOKEN と同じ値にする。長い乱数を使うこと:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TAGURI_NAMES_URL=https://<サービス版のURL>/api/catalog/favourite-names
TAGURI_NAMES_TOKEN=
# EC2 ならインスタンスロールを使い、ここに鍵を書かない。使えないときだけ:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
